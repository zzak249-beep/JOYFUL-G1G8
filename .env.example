# ---------- CREDENCIALES ----------
BINGX_API_KEY=
BINGX_API_SECRET=
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- MODO ----------
# true = solo avisa por Telegram, NO opera (EMPIEZA SIEMPRE ASÍ)
DRY_RUN=true
# true = cuenta demo VST de BingX
BINGX_DEMO=false
# hedge (por defecto en BingX) | oneway
POSITION_MODE=hedge

# ---------- MERCADO ----------
# ALL = todo, TOP:30 = los 30 más líquidos; o una lista. ALL = analiza todo BingX filtrado por liquidez; o una lista: BTC/USDT:USDT,ETH/USDT:USDT
SYMBOLS=ALL
# crypto,stock (opcional: index,fx,commodity)
ASSET_CLASSES=crypto,stock
MIN_VOL_USDT=3000000
MAX_SYMBOLS=120
MAX_SPREAD_PCT=0.06
EXCLUDE=
# acciones: solo sesión regular NYSE (pon false si operas acciones tokenizadas 24/7)
STOCK_RTH_ONLY=true
# 0=Base 1=V2(filtros) 2=V3(+momentum) 3=V4(+HaP)
BOOK=1
MAX_POSITIONS=3

# ---------- RIESGO ----------
RISK_PCT=1.0
MAX_LEV=10
LEVERAGE=10
PARTIAL_MODE=true
TP_SINGLE_R=1.5
ALLOW_LONG=true
ALLOW_SHORT=true

# ---------- PERSISTENCIA (volumen Railway montado en /data) ----------
DATA_DIR=/data

# ---------- TIMEFRAME ----------
# 15m o 1h (los TF superiores se derivan solos). Compara con backtest.py --compare
TF=15m

# ---------- MEJORAS (todas desactivables) ----------
META_ON=true
META_STRICT=false
META_SIZING=false
SEASON_ON=true
FUNDING_ON=false
TRAIL_ON=false
TRAIL_ATR=2.0
VOL_SCALE_ON=false

# ---------- SEGURIDAD ----------
RATE_LIMIT_MS=250
DAILY_LOSS_PCT=3.0

# ---------- AVISOS (formato de tu escáner) ----------
ACCOUNT_USDT=1000            # solo para el tamaño sugerido en modo señales
MAX_OPEN_TRADES=8            # tope de operaciones virtuales abiertas (DRY_RUN)
MAX_SIGNALS_PER_SCAN=15
TELEGRAM_COMMANDS=true       # /stats /semana /abiertas /estado
SUMMARY_HOUR_UTC=8           # -1 = sin resumen diario

# ---------- FILTROS TOMADOS DE TU ESCÁNER (apagados: mídelos con backtest) ----------
USE_ER=false
ER_MIN=0.25
USE_BODY=false
BODY_MIN=0.55
USE_CLIMAX=false
CLIMAX_MULT=1.8
COST_MULT=0

# ---------- CONCENTRACIÓN / TIPO DE TP ----------
MAX_SAME_DIR=2        # máx. posiciones abiertas en la misma dirección
TP_ORDER=trigger      # trigger (visible en TP/SL) | limit (comisión maker; puede no ejecutarse)

# ---------- IDEAS DEL OTRO ANÁLISIS (apagadas: mide con backtest) ----------
DUAL_ON=false         # memoria por código en dos horizontes (corto 18 / largo 90 operaciones)
RANK_TOPK=0           # 0 = off; 3 = solo los 3 mejores códigos por límite inferior
REGIME_EXITS=false    # TP2/barras/tamaño según régimen HaP (el stop no cambia)
SHADOW_ON=true        # en real, sigue cada operación también como virtual para medir la brecha
SLIP_MAX_R=0.15       # slippage medio que recorta el tamaño al 50%
KILL_MIN_N=15         # kill-switch: pausa si virtual - real > KILL_GAP_R en las últimas N
KILL_GAP_R=0.5
MAX_SPREAD_R=0.15     # spread máx. como fracción del stop

# ---------- ESTRATEGIA V9 ----------
STRATEGY=granville     # granville (G1-G8) | v9 (Crowding + Adaptativo)
V9_FAITHFUL=false      # true = replica los fallos del script original
V9_META_MIN=0.50
LEARN_BLOCKED=true     # sigue en silencio las señales bloqueadas por las puertas (aprende sin sesgo)
MAX_LEARN=80

# ---------- IDEAS NUEVAS (apagadas: mídelas con backtest.py --compare-ideas) ----------
FUND_PCT_ON=false     # no operar a favor del lado saturado (percentil de funding a 30 días)
FUND_PCT_HI=0.90
OI_ON=false           # + Open Interest subiendo (solo en vivo; BingX no da histórico)
DELTA_ON=false        # delta aproximado + absorción en contra
VT_ON=false           # volatility targeting relativo (tamaño x0.5-1.25)
MTF_STRICT=false      # HaP del TF mayor a favor (códigos de tendencia)
REGIME4_ON=false     # fuerte / débil / rango / caos
DECAY_ON=false        # tamaño x0.5 si las últimas 12 operaciones rinden <= -0.3R/op

# ---------- VARIOS BOTS ----------
BOT_NAME=             # vacío = G1-G8 o V9 según STRATEGY; se antepone [NOMBRE] a cada mensaje
BOT_TAG=true
